# ── HindiAnime App — Environment Variable Template ────────────────────────────
#
# Copy this file to .env and fill in your real values.
# The .env file is gitignored and never committed.
# See README.md for setup instructions.

# Cloudflare Worker base URL (no trailing slash)
EXPO_PUBLIC_WORKER_BASE_URL=https://your-worker.workers.dev

# Shared proxy secret — must match HINDIANIME_PROXY_SECRET in Cloudflare Worker secrets
EXPO_PUBLIC_PROXY_SECRET=your-secret-here

